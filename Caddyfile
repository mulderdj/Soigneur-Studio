{
	# keep Caddy off the standard ports inside the container
	http_port 8080
	https_port 8443
	# no Let's Encrypt; certificates come from Caddy's own local CA
	local_certs
	skip_install_trust
	# plain http://localhost:8080 must serve the app; without this Caddy
	# redirects it to https://localhost/ (port 443, i.e. some other server)
	auto_https disable_redirects
	# a browser opening https://<IP address>:8443 sends no server name, and
	# inside Docker the address the connection arrives on is the container's
	# own: without this Caddy finds no certificate (ERR_SSL_PROTOCOL_ERROR)
	default_sni {$SOIGNEUR_HOST:localhost}
	# the local CA: an intermediate for 30 days (Caddy's default is 7)
	pki {
		ca local {
			intermediate_lifetime 30d
		}
	}
}

(security_headers) {
	header {
		?X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
}

(root_cert) {
	# Caddy's root certificate (public; never the key), for devices to
	# install as a trusted CA: http://<SOIGNEUR_HOST>:8080/soigneur-root.crt
	handle /soigneur-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=soigneur-root.crt"
		file_server
	}
}

(app) {
	import security_headers
	# account server (docker compose service "api"); without it the app
	# simply works without accounts
	handle /api/* {
		reverse_proxy api:3000
	}
	import root_cert
	# everything else is the app (separate handle, so try_files never
	# rewrites /api requests)
	handle {
		root * /srv
		encode gzip
		# never rewrite missing static assets (with extensions) to /index.html,
		# which would poison the service worker's cacheFirst store
		@missing_asset {
			path_regexp \.[a-zA-Z0-9]{1,8}$
			not file
		}
		handle @missing_asset {
			respond 404
		}
		handle {
			try_files {path} /index.html
			file_server
		}
		@manifest path *.webmanifest
		header @manifest Content-Type "application/manifest+json"
		# the service worker and the page must always be checked for a new
		# build (the other files carry the build's hash in their names)
		@fresh path / /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
	}
}

# Plain HTTP: full app only on localhost (secure context for Bluetooth/ANT+).
# Non-localhost LAN requests can only fetch the public root CA certificate;
# everything else redirects to HTTPS so credentials and API keys never travel
# in cleartext over the network.
:8080 {
	import root_cert
	@localhost host localhost 127.0.0.1 [::1]
	handle @localhost {
		import app
	}
	handle {
		redir https://{$SOIGNEUR_HOST:localhost}:8443{uri} 308
	}
}

# HTTPS for other devices on your network. Set SOIGNEUR_HOST to the name or
# IP address the other devices use, e.g. SOIGNEUR_HOST=192.168.1.20 or
# SOIGNEUR_HOST=soigneur.local. Trust Caddy's root certificate on those
# devices (see README) so the browser treats the page as secure.
# SOIGNEUR_EXTRA_HOSTS: more names the same app answers to, written with the
# port and separated by commas, e.g. the Tailscale name:
#   SOIGNEUR_EXTRA_HOSTS=fedora.example.ts.net:8443
# (the default is a name that never resolves, so nothing is added)
{$SOIGNEUR_HOST:localhost}:8443, {$SOIGNEUR_EXTRA_HOSTS:unused.invalid:8443} {
	# certificates for 7 days instead of Caddy's 12 hours, renewed well
	# before they run out: one renewal that doesn't happen no longer leaves
	# the phones with an insecure connection (no install, no Bluetooth)
	tls {
		issuer internal {
			lifetime 7d
		}
	}
	header Strict-Transport-Security "max-age=31536000"
	import app
}
