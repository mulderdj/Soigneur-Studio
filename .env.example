# Copy to .env next to docker-compose.yml and fill in.

# Name or IP the riding devices use to open the app
# (AUUKI_HOST, the name before the rename, still works)
SOIGNEUR_HOST=soigneur.lan

# More names the app answers to over https (with the port, comma separated),
# e.g. a Tailscale name. Devices must trust Caddy's root certificate.
# SOIGNEUR_EXTRA_HOSTS=myhost.example.ts.net:8443

# Let riders create their own accounts (otherwise the admin creates them)
ALLOW_SIGNUP=false

# Strava (optional). PUBLIC_URL is exactly what riders type in the browser.
PUBLIC_URL=https://soigneur.lan:8443
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
