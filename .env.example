# Copy to .env next to docker-compose.yml and fill in.

# Name or IP the riding devices use to open the app
AUUKI_HOST=auuki.lan

# Let riders create their own accounts (otherwise the admin creates them)
ALLOW_SIGNUP=false

# Strava (optional). PUBLIC_URL is exactly what riders type in the browser.
PUBLIC_URL=https://auuki.lan:8443
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
