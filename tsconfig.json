{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/analytics.js",
    "src/physics.js",
    "src/training/**/*.js",
    "src/analysis/**/*.js",
    "src/views/charts/tooltip.js",
    "src/views/charts/live-chart-data.js",
    "src/views/toast.js",
    "src/views/confirm.js",
    "server/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server/**/*.spec.mjs"
  ]
}
