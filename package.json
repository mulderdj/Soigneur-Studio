{
    "name": "soigneur-studio",
    "description": "Indoor cycling and training, on your own server. Based on Auuki by Dimitar Marinov.",
    "license": "AGPL-3.0-only",
    "private": true,
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "start": "vite",
        "starttls": "VITE_HTTPS=1 vite",
        "build": "vite build",
        "preview": "vite preview",
        "server": "node server/index.js",
        "test:server": "node --test server/app.spec.mjs server/connections.spec.mjs server/intervals.spec.mjs server/intervals-sync.spec.mjs server/garmin.spec.mjs server/garmin-sync.spec.mjs server/zip.spec.mjs server/ride-files.spec.mjs server/access-tokens.spec.mjs server/mcp/mcp.spec.mjs",
        "check:visual": "node test/visual/check.js"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@types/node": "^26.6.11",
        "babel-jest": "^30.5.2",
        "fake-indexeddb": "^6.2.6",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "playwright-core": "^1.65.1",
        "process": "^0.11.10",
        "typescript": "^7.0.2",
        "vite": "^8.4.0"
    },
    "dependencies": {
        "@garmin/fitsdk": "^21.222.0",
        "@material/material-color-utilities": "^0.4.0",
        "@modelcontextprotocol/sdk": "1.32.2",
        "uplot": "^1.6.32",
        "web-ant-plus": "^2.1.0",
        "zod": "4.6.7"
    }
}
